<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">



    <!-- Начало работы с таблицей client -->

    <changeSet id="init-client" author="ECHasov">
        <sqlFile encoding="utf8" path="/db/changelog/2024/09/16-01-changelog-01.sql"/>
        <rollback/>
    </changeSet>

    <changeSet id="update-client" author="ECHasov">
        <sqlFile encoding="utf8" path="/db/changelog/2024/09/16-01-changelog-02.sql"/>
        <rollback/>
    </changeSet>

    <changeSet id="insert-initial-data-client" author="KKorneev">
        <sqlFile encoding="utf8" path="/db/changelog/2025/01/16-01-changelog-01.sql"/>
        <rollback>
            DELETE FROM client WHERE id BETWEEN 1 AND 20;
        </rollback>
    </changeSet>



    <!-- Начало работы с таблицей account -->
    <changeSet id="init-account" author="k_korneeev">
        <comment>Инициализация таблицы account</comment>
        <sqlFile encoding="utf8" path="/db/changelog/2025/01/16-01-changelog-02.sql"/>
        <rollback>
            DROP TABLE account;
        </rollback>
    </changeSet>

    <changeSet id="update-account" author="k_korneeev">
        <comment>Добавление столбцов в таблицу account</comment>
        <sqlFile encoding="utf8" path="/db/changelog/2025/01/16-01-changelog-03.sql"/>
        <rollback>
            ALTER TABLE client DROP COLUMN account_type;
            ALTER TABLE client DROP COLUMN balance;
        </rollback>
    </changeSet>

    <changeSet id="insert-initial-data-account" author="k_korneeev">
        <comment>Вставка данных в таблицу account</comment>
        <sqlFile encoding="utf8" path="/db/changelog/2025/01/16-01-changelog-04.sql"/>
        <rollback>
            DELETE FROM account WHERE id BETWEEN 1 AND 20;
        </rollback>
    </changeSet>



    <!-- Начало работы с таблицей transaction -->
    <changeSet id="init-transaction" author="k_korneeev">
        <comment>Инициализация таблицы transaction</comment>
        <sqlFile encoding="utf8" path="/db/changelog/2025/01/16-01-changelog-05.sql"/>
        <rollback>
            DROP TABLE transaction;
        </rollback>
    </changeSet>

    <changeSet id="update-transaction" author="k_korneeev">
        <comment>Добавление столбцов в таблицу transaction</comment>
        <sqlFile encoding="utf8" path="/db/changelog/2025/01/16-01-changelog-06.sql"/>
        <rollback>
            ALTER TABLE client DROP COLUMN account_id;
            ALTER TABLE client DROP COLUMN amount;
            ALTER TABLE client DROP COLUMN transaction_time;
        </rollback>
    </changeSet>

    <changeSet id="insert-initial-data-transaction" author="k_korneeev">
        <comment>Вставка данных в таблицу transaction</comment>
        <sqlFile encoding="utf8" path="/db/changelog/2025/01/16-01-changelog-07.sql"/>
        <rollback>
            DELETE FROM transaction WHERE id BETWEEN 1 AND 20;
        </rollback>
    </changeSet>

</databaseChangeLog>